generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes          Recipe[]
  pendingRecipes   PendingRecipe[]
  favorites        Favorite[]
  ratings          Rating[]
  comments         Comment[]
  moderatedRecipes Recipe[]        @relation("ModeratedBy")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model Recipe {
  id           String     @id @default(cuid())
  title        String
  description  String
  country      String
  prepTime     Int
  cookTime     Int
  servings     Int
  difficulty   Difficulty
  type         RecipeType
  diet         Diet[]
  instructions String     @db.Text
  imageUrl     String?

  // Champs de modération
  status         RecipeStatus @default(PENDING)
  isPublished    Boolean      @default(false)
  moderationNote String?      @db.Text
  moderatedAt    DateTime?
  moderatedById  String?

  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy User?        @relation("ModeratedBy", fields: [moderatedById], references: [id])
  ingredients Ingredient[]
  favorites   Favorite[]
  ratings     Rating[]
  comments    Comment[]

  @@index([authorId])
  @@index([status])
  @@index([isPublished])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeType {
  STARTER
  MAIN
  DESSERT
  SNACK
  DRINK
}

enum Diet {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  HALAL
  KOSHER
}

model Ingredient {
  id       String @id @default(uuid())
  name     String
  quantity String
  unit     String

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Rating {
  id        String   @id @default(uuid())
  score     Int // 1 à 5
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model PendingRecipe {
  id           String       @id @default(uuid())
  title        String
  description  String
  country      String
  prepTime     Int
  cookTime     Int
  servings     Int
  difficulty   Difficulty
  type         RecipeType
  diet         Diet[]
  imageUrl     String?
  instructions String       @db.Text
  ingredients  Json // Stocké en JSON temporairement
  status       RecipeStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum RecipeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}
